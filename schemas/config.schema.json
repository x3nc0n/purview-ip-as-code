{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Purview label definitions",
  "type": "array",
  "minItems": 1,
  "items": {
        "type": "object",
        "required": ["key", "name", "tier", "parent", "protection"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "tier": { "type": "integer", "minimum": 0 },
          "parent": { "type": ["string", "null"] },
          "priority": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" },
          "scopes": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "enum": ["File", "Email", "Site", "UnifiedGroup"] }
          },
          "container": {
            "type": "object",
            "required": ["privacy", "allowGuests", "externalSharing"],
            "properties": {
              "privacy": { "type": "string", "enum": ["Private", "Public"] },
              "allowGuests": { "type": "boolean" },
              "externalSharing": { "type": "string", "enum": ["ExistingExternalUserSharingOnly", "Disabled"] }
            },
            "additionalProperties": false
          },
          "autoLabeling": {
            "type": "object",
            "required": ["mode", "conditions"],
            "properties": {
              "mode": { "type": "string", "enum": ["Automatic", "Recommend"] },
              "conditions": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["sitKey", "minCount", "maxCount", "minConfidence"],
                  "properties": {
                    "sitKey": { "type": "string", "minLength": 1 },
                    "minCount": { "type": "integer", "minimum": 1 },
                    "maxCount": { "type": ["integer", "null"], "minimum": 1 },
                    "minConfidence": { "type": "integer", "enum": [65, 75, 85] }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "protection": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["none", "user-defined", "fixed-group"]
              },
              "rights": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              },
              "groupKey": { "type": ["string", "null"] },
              "offlineAccessDays": { "type": ["integer", "null"], "minimum": 1 },
              "contentExpiration": { "type": ["string", "null"] },
              "encrypt": { "type": "boolean" },
              "doNotForward": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
    "additionalProperties": false
  }
}
