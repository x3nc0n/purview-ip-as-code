{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Custom SIT definitions",
  "type": "object",
  "required": ["schemaVersion", "package", "proximityCharacters", "detectors"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "package": {
      "type": "object",
      "required": ["id", "publisherId", "name", "version"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "publisherId": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$" }
      },
      "additionalProperties": false
    },
    "proximityCharacters": { "type": "integer", "enum": [300] },
    "detectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "name", "entityId", "rationale", "primary", "supporting", "patterns"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "entityId": { "type": "string", "format": "uuid" },
          "rationale": { "type": "string" },
          "primary": { "type": "string", "minLength": 1 },
          "supporting": { "type": "array", "items": { "type": "string" } },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["confidence", "primaryRegex", "supportRegexes"],
              "properties": {
                "confidence": { "type": "integer", "enum": [65, 75, 85] },
                "primaryRegex": { "type": "string", "minLength": 1 },
                "supportRegexes": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
